RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=Aurelia <onboarding@resend.dev>
# Use a verified sending domain with Resend in production.
# Without RESEND_API_KEY, validated inquiries are logged on the server and return success.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=file:./data/app.db
STORAGE_DIR=./storage
# S3 is an explicit stub until production adapter work is completed.
STORAGE_PROVIDER=local
# Single-admin login. Use a strong password and at least 32 random characters for SESSION_SECRET.
# Changing either value invalidates existing sessions. Restart the server after changing secrets.
ADMIN_PASSWORD=
SESSION_SECRET=
# Leave both unset for Manual Upload mode. No hardcoded model default is used.
# Google reports Gemini API Veo 3.1 preview shutdown on 2026-10-22.
# Only set VEO_MODEL after verifying current account access and first/last-frame support.
# Unsupported or unavailable models fall back to Manual Upload with the exact error.
GEMINI_API_KEY=
VEO_MODEL=
