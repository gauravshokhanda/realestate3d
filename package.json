{
  "name": "aurelia-residences",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-prisma.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "frames": "node scripts/make-placeholder-frames.mjs",
    "test:sequence": "node --unhandled-rejections=strict --test tests/sequence-loader.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "import": "node scripts/import-sequence.mjs",
    "test:import": "node --test tests/import-sequence.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed && tsx scripts/attach-legacy-videos.ts",
    "test:storage": "tsx --test tests/storage.test.ts",
    "test:admin": "tsx --test tests/admin.test.ts",
    "test:jobs": "tsx --conditions react-server --test tests/jobs.test.ts",
    "worker": "tsx --conditions react-server scripts/worker.ts",
    "perf": "node scripts/perf.mjs",
    "pano:fixtures": "node scripts/make-test-panoramas.mjs",
    "test:panorama": "tsx --test tests/panorama.test.ts tests/panorama-source.test.ts",
    "pano:demo": "node scripts/make-test-panoramas.mjs && tsx --conditions react-server scripts/seed-panorama-demo.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/gyroscope-plugin": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
    "@prisma/client": "6.19.3",
    "busboy": "^1.6.0",
    "dotenv": "^18.0.9",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.23.0",
    "gsap": "^3.13.0",
    "jose": "^6.2.16",
    "lenis": "^1.3.0",
    "lucide-react": "^1.70.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.0",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
